# Grok-Hermes Symbiosis - Cross-Platform .stignore
# Merged Windows + Linux patterns for reliable bidirectional sync

# Version control
.git
.gitignore

# Secrets & credentials (NEVER sync these)
.env
.env.*
**/.env
**/secrets/
**/*.key
**/*.pem
**/*token*
**/*secret*
**/*password*

# Agent homes & state (critical - machine specific)
**/.hermes/
**/.grok/
**/%LOCALAPPDATA%/hermes/
**/%APPDATA%/hermes/
**/.config/hermes/
**/.local/share/hermes/

# Build / dependency caches
node_modules/
.venv/
__pycache__/
*.pyc
dist/
build/
target/
vendor/
*.o
*.a
*.so
*.dll

# OS noise (both platforms)
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.swp
*~

# Large / unnecessary files
*.iso
*.mp4
*.zip
*.tar.gz
*.rar
*.7z
models/
downloads/
*.pt
*.bin
*.safetensors

# Logs (optional)
*.log
logs/

# Syncthing internal
.synt*
.stignore

# Windows-specific noise
*.lnk
*.exe.bak
